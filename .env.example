# URL base del API. Vacío = mismo origen (en desarrollo Vite redirige /api al backend).
VITE_API_URL=

# Backend al que apunta el proxy de desarrollo de Vite.
API_PROXY_TARGET=https://fastapi.inventarios.proyecto.lol

# --- Despliegue con Docker Compose ---
# Puerto publicado solo al usar docker-compose.local.yml (en Coolify no se usa).
WEB_PORT=8080
# Backend al que Nginx redirige /api (sin barra al final).
API_UPSTREAM=https://fastapi.inventarios.proyecto.lol
